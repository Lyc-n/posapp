{
  "name": "posapp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start -w @posapp/mobile",
    "dev:web": "npm run dev -w @posapp/web",
    "build:web": "npm run build -w @posapp/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "expo-router": "~58.0.31"
  }
}
